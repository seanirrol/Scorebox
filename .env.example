DISCORD_TOKEN=your-discord-bot-token-here

# TheSportsDB API key. "3" is the shared free test key — get your own free
# key at https://www.thesportsdb.com/api.php if you hit rate limits.
SPORTSDB_API_KEY=3

# Seconds between live-score refreshes for /track
UPDATE_INTERVAL_SECONDS=60

# Safety cap: stop auto-updating a match after this many hours
MAX_TRACK_HOURS=6
